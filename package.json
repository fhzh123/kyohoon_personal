{
  "name": "kyohoon-home",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/dev.mjs",
    "start": "node --env-file-if-exists=.env.local server/start.mjs",
    "build": "node scripts/build.mjs",
    "build:resume": "node scripts/build-resume.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "import:work": "node scripts/import-work.mjs",
    "upload:work": "node --env-file-if-exists=.env.local scripts/upload-work.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/preset-env": "7.28.0",
    "@babel/preset-react": "7.27.1",
    "autoprefixer": "10.4.21",
    "babel-loader": "8.4.1",
    "jsdom": "16.7.0",
    "postcss": "8.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "3.4.17",
    "typescript": "4.9.5",
    "webpack": "5.100.2"
  }
}
