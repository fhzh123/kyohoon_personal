{
  "version": 2,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{server,views,work-app,work-expenses,public}/**",
      "excludeFiles": "{private,Assets,assets-extracted,assets-generated,artifacts}/**"
    }
  },
  "regions": [
    "hnd1"
  ],
  "routes": [
    {
      "src": "/resume/?",
      "dest": "/api/index"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index"
    }
  ]
}
